{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r .tool_input.command // empty | head -c 80); echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) TOOL=Bash cmd=$CMD\" >> /tmp/claude_agent_log.txt'"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); DESC=$(echo \"$INPUT\" | jq -r .tool_input.description // empty); echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) AGENT spawn desc=$DESC\" >> /tmp/claude_agent_log.txt'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r .tool_input.file_path // empty); echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) TOOL=Write file=$FILE\" >> /tmp/claude_agent_log.txt'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r .tool_input.file_path // empty); echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) TOOL=Edit file=$FILE\" >> /tmp/claude_agent_log.txt'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Agent",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(pwd*)",
      "Bash(which *)",
      "Bash(env*)",
      "Bash(printenv *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git stash*)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(pytest*)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(pip freeze*)",
      "Bash(pip show*)",
      "Bash(npm install*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)"
    ]
  }
}
